<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.0</version>
    <relativePath/>
  </parent>

  <groupId>com.steglab</groupId>
  <artifactId>steglab-backend</artifactId>
  <version>2.0.0</version>
  <name>StegLab Backend</name>
  <description>
    Offline steganography and steganalysis engine. All processing is pure Java 17:
    javax.imageio for images, javax.sound.sampled for WAV, javax.crypto for AES-256-GCM.
    PDFBox is used exclusively for report generation.
  </description>

  <properties>
    <java.version>17</java.version>
    <pdfbox.version>2.0.29</pdfbox.version>
    <!-- Patch-level alignment with the vendored offline Maven cache. -->
    <classmate.version>1.7.0</classmate.version>
  </properties>

  <dependencies>
    <!-- REST controllers, multipart upload, embedded Tomcat -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Bean validation for request DTOs -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- PDF report generation only. No stego processing happens in this library. -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>${pdfbox.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>steglab-backend</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
